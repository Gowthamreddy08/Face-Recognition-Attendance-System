# Copy this file to .env for local development and fill in real values.
# Never commit the actual .env file.

# Flask session secret — any long random string
SECRET_KEY=change-this-to-a-long-random-string

# Postgres connection string
# Local example:   postgresql://postgres:password@localhost:5432/attendance
# Render/Railway provide this automatically once you add a Postgres addon.
DATABASE_URL=postgresql://user:password@localhost:5432/attendance

# Use "require" for hosted Postgres, "disable" for local Postgres without SSL
DB_SSLMODE=disable

# Email used for sending notifications (optional feature)
EMAIL_ADDRESS=yourgmail@gmail.com
EMAIL_PASSWORD=your_16_character_app_password

# Set to "true" only when running locally on a machine with a real
# webcam. Leave "false" (or unset) on any cloud deployment.
ENABLE_WEBCAM=false

# Port Flask binds to locally (cloud platforms usually set this for you)
PORT=5000
